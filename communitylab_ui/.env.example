# ---------------------------------------------------------------
# CommunityLab - plantilla de variables de entorno
#
# COMO USARLO:
#   1. Copia este archivo y renombralo a  .env
#   2. Llena los valores reales
#   3. NUNCA subas el .env al repositorio (ya esta en .gitignore)
#
#   cp .env.example .env
# ---------------------------------------------------------------

# De donde se leen los secretos: env | vault | auto
FUENTE_SECRETOS=auto

# Modelo de lenguaje
GEMINI_API_KEY=

# OCI Object Storage
OCI_NAMESPACE=
OCI_BUCKET=communitylab-activos
OCI_REGION=mx-queretaro-1

# OCI Vault. Si tienes acceso a OCI, pon aqui el OCID del Vault. Si no, dejalo vacio y usa tus claves en el .env
OCI_VAULT_OCID=
COHERE_API_KEY=
OCI_CONFIG_PROFILE=DEFAULT
