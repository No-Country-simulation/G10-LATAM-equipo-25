# ---------------------------------------------------------------
# CommunityLab - plantilla de variables de entorno
#
# COMO USARLO:
#   1. Copia este archivo y renombralo a  .env
#   2. Llena los valores reales
#   3. NUNCA subas el .env al repositorio (ya esta en .gitignore)
#
#   cp .env.example .env
# ---------------------------------------------------------------

# Direccion del backend (FastAPI). Por defecto: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Contraseña para entrar al panel. Vacia: no la pide (uso local).
# Solo hace falta cuando el panel se publica en internet.
PANEL_PASSWORD=

# De donde se leen los secretos: env | vault | auto
#   env = este archivo  ·  vault = OCI Vault  ·  auto = Vault y, si falla, este archivo
#   auto es lo recomendado: sin OCI_VAULT_ID usa este archivo sin avisos.
FUENTE_SECRETOS=auto

# Modelo de lenguaje
GEMINI_API_KEY=

# OCI Object Storage
OCI_NAMESPACE=
OCI_BUCKET=communitylab-activos
OCI_REGION=mx-queretaro-1

# Busqueda de FAQs (la usa el backend; aqui solo se muestra si esta configurada)
COHERE_API_KEY=

# OCI Vault. Si tienes acceso a OCI, pon aqui el OCID del Vault (tambien se
# acepta OCI_VAULT_OCID). Si no, dejalo vacio y usa tus claves en este archivo.
# OCI_AUTH: config (archivo ~/.oci/config) | instance_principal (OCI Compute)
OCI_VAULT_ID=
OCI_AUTH=config
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
# Opcionales: si el Vault esta en otra region o en otra cuenta de OCI que el bucket.
# Vacios = se usan OCI_REGION y OCI_CONFIG_PROFILE. El perfil es una seccion de ~/.oci/config.
OCI_VAULT_REGION=
OCI_VAULT_CONFIG_PROFILE=
