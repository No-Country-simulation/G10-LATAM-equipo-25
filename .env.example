# ---------------------------------------------------------------
# CommunityLab backend - plantilla de variables de entorno
#
# Como usarlo:
#   1. Copia este archivo y renombralo a  .env  (en la raiz del repo)
#   2. Cambia solo lo que necesites. Sin cambiar nada, el backend
#      funciona completo en modo local: sin claves y sin internet.
#   3. NUNCA subas el .env al repositorio (ya esta en .gitignore)
# ---------------------------------------------------------------

# --- Modelo de lenguaje: mock (reglas locales) | gemini ---
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Modelo con el que se probaron todos los ejemplos
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Busqueda de FAQs ---
# faq_db   = busca en data/motor_educativo.db, sin claves (por defecto)
# semantic = Cohere Embed + Rerank sobre data/faq_index.json (requiere COHERE_API_KEY)
# mock     = sin evidencia
RETRIEVAL_PROVIDER=faq_db
FAQ_DB_PATH=data/motor_educativo.db
# Copias de seguridad de la base al agregar FAQs y historial de dudas frecuentes (no se suben a git)
FAQ_BACKUP_DIR=data/respaldos
HISTORY_DB_PATH=data/historial_dudas.db

# Solo con RETRIEVAL_PROVIDER=semantic
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=mock
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
COHERE_RERANK_MODEL=rerank-v4.0-pro
FAQ_INDEX_PATH=data/faq_index.json
RETRIEVAL_CANDIDATES=20
# Relevancia mínima (0 a 1) para aceptar una FAQ en la búsqueda semántica
RETRIEVAL_MIN_SCORE=0.5

# --- Almacenamiento de paquetes: local | oci ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=salidas/paquetes

# Solo con STORAGE_PROVIDER=oci
OCI_NAMESPACE=
OCI_BUCKET=communitylab-activos-marketing
OCI_REGION=
OCI_AUTH=config
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_OBJECT_PREFIX=activos

# --- Memoria del motor (historial de dudas y FAQs agregadas): local | oci ---
# local = archivos en data/ (por defecto)
# oci   = los mismos archivos, respaldados en el bucket de arriba bajo OCI_STATE_PREFIX.
#         Necesario en servidores cuyo disco se borra al reiniciar (Hugging Face Spaces).
STATE_PROVIDER=local
OCI_STATE_PREFIX=estado

# --- Origen de las claves de Gemini y Cohere: environment | oci ---
# environment = lee GEMINI_API_KEY y COHERE_API_KEY de este archivo (por defecto)
# oci         = las lee de OCI Vault (produccion). Ver docs/secretos.md
SECRET_PROVIDER=environment

# Solo con SECRET_PROVIDER=oci (usa tambien OCI_AUTH, OCI_REGION,
# OCI_CONFIG_FILE y OCI_CONFIG_PROFILE de la seccion anterior).
# En OCI Compute: OCI_AUTH=instance_principal y dejar vacias las claves de arriba.
OCI_VAULT_ID=
# Opcionales: si el Vault esta en otra region o en otra cuenta de OCI que el bucket.
# Vacios = se usan OCI_REGION y OCI_CONFIG_PROFILE. El perfil es una seccion de ~/.oci/config.
OCI_VAULT_REGION=
OCI_VAULT_CONFIG_PROFILE=
OCI_SECRET_GEMINI=communitylab-gemini-api-key
OCI_SECRET_COHERE=communitylab-cohere-api-key

PROVIDER_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
